# ---- Core ----
# Secret used to sign JWT session tokens. Generate a long random value for production.
SECRET_KEY=dev-only-change-me-1f3a5c7e9b2d4f6a8c0e2b4d6f8a1c3e

# SQLite for local development (default). Created automatically on first start.
DATABASE_URL=sqlite:///./travel_planner.db
# Supabase (production): create a project, run supabase/schema.sql in its SQL editor,
# then paste the connection pooler string from Project Settings > Database:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Comma-separated list of allowed frontend origins (Vercel URL in production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Generative AI ----
# Use Google Gemini, Groq, or both. Whichever key is set is used;
# if both are set, AI_PROVIDER decides ("auto" prefers Groq, then Gemini).
# Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Groq: free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# auto | groq | gemini  (only matters when both keys are set)
AI_PROVIDER=auto
# With no AI key at all, the built-in demo itinerary engine is used (no network needed).

# ---- Images (Unsplash) ----
# Get a free key at https://unsplash.com/developers → New Application.
# Leave empty and the UI shows gradient placeholders instead of photos.
UNSPLASH_ACCESS_KEY=
